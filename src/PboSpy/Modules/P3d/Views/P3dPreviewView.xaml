<UserControl x:Class="PboSpy.Modules.P3d.Views.P3dPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:loc="clr-namespace:PboSpy.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource PboSpy.Surface}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DockPanel Margin="8 6" LastChildFill="False">
            <RadioButton GroupName="P3dMode" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.Model}"
                         IsChecked="{Binding ShowModel, Mode=TwoWay}" IsEnabled="{Binding HasModel}"/>
            <RadioButton GroupName="P3dMode" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.Details}" Margin="4 0 16 0"
                         IsChecked="{Binding ShowDetails, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Tr P3dView.Lod}" Style="{StaticResource PboSpy.Label}"/>
                <ComboBox x:Name="LodPicker" IsEnabled="{Binding HasLodChoice}" ItemsSource="{Binding ModelLods}" SelectedItem="{Binding SelectedLod}" MinWidth="170" Margin="0 0 14 0"/>
                <StackPanel Orientation="Horizontal" Margin="0 0 14 0">
                    <RadioButton x:Name="ShadeWire" GroupName="Shading" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.Wireframe}" Checked="OnShading"/>
                    <RadioButton x:Name="ShadeSolid" GroupName="Shading" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.Solid}" Checked="OnShading"/>
                    <RadioButton x:Name="ShadeMaterial" GroupName="Shading" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.MaterialPreview}" Checked="OnShading"/>
                    <RadioButton x:Name="ShadeRendered" GroupName="Shading" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.Rendered}" Checked="OnShading"
                                 ToolTip="{loc:Tr P3dView.DetailMapsTip}"/>
                </StackPanel>
                <ToggleButton x:Name="DenseToggle" Style="{StaticResource PboSpy.Button}" Content="{loc:Tr P3dView.Dense}" Click="OnDense"
                              ToolTip="{loc:Tr P3dView.DenseTip}" Visibility="Collapsed" Margin="0 0 14 0"/>
                <Button Content="{loc:Tr P3dView.ResetView}" Style="{StaticResource PboSpy.Button}" Click="OnResetView" Margin="0 0 6 0"/>
                <Button Content="{loc:Tr P3dView.TextureFolder}" Style="{StaticResource PboSpy.Button}" Click="OnPickFolder"
                        ToolTip="{loc:Tr P3dView.TextureFolderTip}"/>
                <Button Content="{loc:Tr P3dView.ExportObj}" Style="{StaticResource PboSpy.Button}" Click="OnExportObj"
                        ToolTip="{loc:Tr P3dView.ExportObjTip}" Margin="6 0 0 0"/>
            </StackPanel>
            <TextBlock x:Name="StatsText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource PboSpy.TextDim}"
                       Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>

        <Grid Grid.Row="1" x:Name="ModelPanel" Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="290" MinWidth="160"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ViewHost" Background="{DynamicResource PboSpy.Deep}" ClipToBounds="True" Focusable="True"
                    MouseDown="OnViewMouseDown" MouseMove="OnViewMouseMove" MouseUp="OnViewMouseUp" MouseWheel="OnViewMouseWheel"
                    LostMouseCapture="OnViewLostCapture" KeyDown="OnViewKeyDown" KeyUp="OnViewKeyUp">
                <Grid>
                    <Viewport3D x:Name="Viewport" IsHitTestVisible="False" RenderOptions.EdgeMode="Unspecified">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera" FieldOfView="45" UpDirection="0 1 0"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="SceneRoot">
                                    <AmbientLight Color="#FF707070"/>
                                    <DirectionalLight x:Name="HeadLight" Color="#FFE0E0E0" Direction="0 -0.3 -1"/>
                                    <DirectionalLight Color="#FF3C3C3C" Direction="0.3 -1 0.4"/>
                                    <Model3DGroup x:Name="Parts"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                    <Image x:Name="WireImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                           Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource PboSpy.TextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                    <TextBlock Text="{loc:Tr P3dView.Hint}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10 0 10 8"
                               FontSize="11" Foreground="{DynamicResource PboSpy.TextDim}" IsHitTestVisible="False"/>
                    <TextBlock x:Name="WalkText" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10 8" FontSize="12"
                               Foreground="{DynamicResource PboSpy.Text}" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="PerfText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10 0 10 8"
                               FontSize="11" FontFamily="Consolas" TextAlignment="Right" Foreground="{DynamicResource PboSpy.TextDim}" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource PboSpy.Border}"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr P3dView.Textures}" Style="{StaticResource PboSpy.Section}" Margin="10 8 10 6"/>
                <ListBox x:Name="TextureList" ItemsSource="{Binding TextureItems}" Style="{StaticResource PboSpy.ListBox}"
                         BorderThickness="0" Background="{DynamicResource PboSpy.Surface}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2 3" ToolTip="{Binding Tooltip}" Background="Transparent" MouseRightButtonUp="OnTextureRowRightClick" MouseLeftButtonDown="OnTextureRowClick">
                                <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="0 0 8 0" CornerRadius="2"
                                        BorderThickness="1" BorderBrush="{DynamicResource PboSpy.Border}" Background="{Binding Swatch}">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⋯ ▾" Style="{StaticResource PboSpy.Button}" Padding="6 1" Click="OnTextureMenu"
                                            ToolTip="{loc:Tr P3dView.More}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PboSpy.Text}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{Binding StatusBrush}"/>
                                    <TextBlock Text="{Binding Linked}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PboSpy.TextDim}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <xctk:PropertyGrid SelectedObject="{Binding Summary}"
                               ShowSortOptions="False" ShowSearchBox="False" IsCategorized="False"
                               BorderThickness="0" Background="{DynamicResource PboSpy.Surface}"
                               Foreground="{DynamicResource PboSpy.Text}"/>
            <ListView x:Name="LODs" Grid.Row="1" VirtualizingPanel.ScrollUnit="Pixel"/>
        </Grid>
    </Grid>
</UserControl>
