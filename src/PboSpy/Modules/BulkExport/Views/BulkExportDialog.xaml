<Window x:Class="PboSpy.Modules.BulkExport.Views.BulkExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:PboSpy.Modules.BulkExport.Models"
        xmlns:loc="clr-namespace:PboSpy.Localization"
        Title="{loc:Tr BulkExport.Title}" Height="720" Width="640" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" ResizeMode="CanResize"
        Background="{DynamicResource PboSpy.Surface}" Foreground="{DynamicResource PboSpy.Text}">
    <Window.Resources>
        <ObjectDataProvider x:Key="ImageFormats" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ImageOutputFormat"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AudioFormats" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AudioOutputFormat"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="PaaFormats" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PaaOutputFormat"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="Presets" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ContentPreset"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="SanitizeModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:NameSanitizeMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ExistingActions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ExistingFileAction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0 4 8 4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeViewItem.Static.Text}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0 3 0 3"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeViewItem.Static.Text}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeViewItem.Static.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TreeView.Static.Border}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TreeViewItem.Static.Text}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsPanel">
                <GroupBox Header="{loc:Tr BulkExport.Source}">
                    <DockPanel>
                        <TextBlock x:Name="SourceSummary" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="4"/>
                        <StackPanel DockPanel.Dock="Right" Margin="6 0 0 0">
                            <Button Content="{loc:Tr BulkExport.AddFiles}" Padding="8 2" Click="OnAddFiles"/>
                            <Button Content="{loc:Tr BulkExport.AddFolder}" Padding="8 2" Margin="0 4" Click="OnAddFolder"/>
                            <Button Content="{loc:Tr BulkExport.RemoveSource}" Padding="8 2" Click="OnRemoveSource"/>
                        </StackPanel>
                        <ListBox x:Name="SourceList" Height="84" SelectionMode="Extended" KeyDown="OnSourceKey" Style="{StaticResource PboSpy.ListBox}"/>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="{loc:Tr BulkExport.Output}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="{loc:Tr BulkExport.Folder}"/>
                        <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{loc:Tr Common.Browse}" Padding="10 2" Margin="6 0 0 0" Click="OnBrowse"/>

                        <Label Grid.Row="1" Content="{loc:Tr BulkExport.Include}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource Presets}}"
                                  SelectedItem="{Binding Preset}" Margin="0 4 0 0"/>

                        <Label Grid.Row="2" Content="{loc:Tr BulkExport.Extensions}"
                               Visibility="{Binding IsCustomPreset, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 4 0 0" Visibility="{Binding IsCustomPreset, Converter={StaticResource BoolToVis}}"/>

                        <Label Grid.Row="3" Content="{loc:Tr BulkExport.InvalidChars}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Source={StaticResource SanitizeModes}}"
                                  SelectedItem="{Binding SanitizeMode}" Margin="0 4 0 0"/>

                        <Label Grid.Row="4" Content="{loc:Tr BulkExport.Existing}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Source={StaticResource ExistingActions}}"
                                  SelectedItem="{Binding ExistingFileAction}" Margin="0 4 0 0"/>

                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0 6 0 0">
                            <CheckBox Content="{loc:Tr BulkExport.KeepStructure}" IsChecked="{Binding PreserveStructure}"/>
                            <CheckBox Content="{loc:Tr BulkExport.DropPrefix}" IsChecked="{Binding StripPboPrefix}"
                                      IsEnabled="{Binding PreserveStructure}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="TexturesGroup" Header="{loc:Tr BulkExport.Textures}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.ColumnSpan="2" Content="{loc:Tr BulkExport.ConvertImages}" IsChecked="{Binding ConvertImages}"/>

                        <Label Grid.Row="1" Content="{loc:Tr BulkExport.Format}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource ImageFormats}}"
                                  SelectedItem="{Binding ImageFormat}" IsEnabled="{Binding ConvertImages}" Margin="0 4 0 0"/>

                        <Label Grid.Row="2" Content="{loc:Tr BulkExport.JpegQuality}"
                               Visibility="{Binding IsLossyFormat, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0 4 0 0"
                                   Visibility="{Binding IsLossyFormat, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Width="34" Margin="6 0 0 0" Text="{Binding JpegQuality}" VerticalAlignment="Center"/>
                            <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding JpegQuality}"/>
                        </DockPanel>

                        <Label Grid.Row="3" Content="{loc:Tr BulkExport.MaxSize}"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0 4 0 0">
                            <TextBox Width="70" DockPanel.Dock="Left" Text="{Binding MaxSize, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding ConvertImages}"/>
                            <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap"
                                       Text="{loc:Tr BulkExport.MaxSizeHint}"/>
                        </DockPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0 6 0 0">
                            <CheckBox IsChecked="{Binding RebuildNormalMaps}" IsEnabled="{Binding ConvertImages}"
                                      Content="{loc:Tr BulkExport.RepairNormals}" ToolTip="{loc:Tr BulkExport.RepairNormalsTip}"/>
                            <CheckBox IsChecked="{Binding GrayscaleDataMaps}" IsEnabled="{Binding ConvertImages}"
                                      Content="{loc:Tr BulkExport.Grayscale}"/>
                            <CheckBox IsChecked="{Binding KeepOriginalImages}" Content="{loc:Tr BulkExport.KeepPaa}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="ToPaaGroup" Header="{loc:Tr BulkExport.ToPaa}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.ColumnSpan="2" Content="{loc:Tr BulkExport.ConvertToPaa}" IsChecked="{Binding ConvertImagesToPaa}"/>
                        <Label Grid.Row="1" Content="{loc:Tr BulkExport.Format}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource PaaFormats}}"
                                  SelectedItem="{Binding PaaFormat}" IsEnabled="{Binding ConvertImagesToPaa}" Margin="0 4 0 0"
                                  ToolTip="{loc:Tr BulkExport.PaaFormatTip}"/>
                        <Label Grid.Row="2" Content="{loc:Tr BulkExport.MaxPaaSize}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0 4 0 0"
                                 Text="{Binding MaxPaaSize, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConvertImagesToPaa}"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0 6 0 0" IsChecked="{Binding ResizeToPowerOfTwo}"
                                  IsEnabled="{Binding ConvertImagesToPaa}" Content="{loc:Tr BulkExport.PowerOfTwo}"/>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="AudioGroup" Header="{loc:Tr BulkExport.Audio}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.ColumnSpan="2" Content="{loc:Tr BulkExport.ConvertAudio}" IsChecked="{Binding ConvertAudio}"/>

                        <Label Grid.Row="1" Content="{loc:Tr BulkExport.Format}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource AudioFormats}}"
                                  SelectedItem="{Binding AudioFormat}" IsEnabled="{Binding ConvertAudio}" Margin="0 4 0 0"/>

                        <Label Grid.Row="2" Content="{loc:Tr BulkExport.Bitrate}"
                               Visibility="{Binding UsesBitrate, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0 4 0 0"
                                   Visibility="{Binding UsesBitrate, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Width="64" Margin="6 0 0 0" VerticalAlignment="Center">
                                <Run Text="{Binding AudioBitrate}"/> kbps
                            </TextBlock>
                            <Slider Minimum="64" Maximum="320" TickFrequency="32" IsSnapToTickEnabled="True" Value="{Binding AudioBitrate}"/>
                        </DockPanel>

                        <Label Grid.Row="3" Content="{loc:Tr BulkExport.OggQuality}"
                               Visibility="{Binding UsesOggQuality, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0 4 0 0"
                                   Visibility="{Binding UsesOggQuality, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Width="34" Margin="6 0 0 0" Text="{Binding OggQuality}" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OggQuality}"/>
                        </DockPanel>

                        <Label Grid.Row="4" Content="{loc:Tr BulkExport.SampleRate}"/>
                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0 4 0 0">
                            <ComboBox Width="110" DockPanel.Dock="Left" IsEditable="True" Text="{Binding AudioSampleRate, UpdateSourceTrigger=LostFocus}">
                                <sys:Int32>0</sys:Int32>
                                <sys:Int32>22050</sys:Int32>
                                <sys:Int32>32000</sys:Int32>
                                <sys:Int32>44100</sys:Int32>
                                <sys:Int32>48000</sys:Int32>
                            </ComboBox>
                            <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Opacity="0.6" Text="{loc:Tr BulkExport.SampleRateHint}"/>
                        </DockPanel>

                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0 6 0 0">
                            <CheckBox IsChecked="{Binding AudioMono}" Content="{loc:Tr BulkExport.Mono}"/>
                            <CheckBox IsChecked="{Binding NormalizeAudio}" Content="{loc:Tr BulkExport.Normalize}"/>
                            <CheckBox IsChecked="{Binding KeepOriginalAudio}" Content="{loc:Tr BulkExport.KeepAudio}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="ConfigsGroup" Header="{loc:Tr BulkExport.Configs}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding ConvertConfigs}" Content="{loc:Tr BulkExport.ConvertConfigs}"/>
                        <CheckBox IsChecked="{Binding KeepOriginalConfigs}" Content="{loc:Tr BulkExport.KeepConfigs}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0 8 0 0">
            <ProgressBar x:Name="Progress" Height="16" Minimum="0"/>
            <TextBlock x:Name="Status" Margin="0 4 0 0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0 10 0 0" LastChildFill="False">
            <CheckBox x:Name="OpenFolderCheck" DockPanel.Dock="Left" VerticalAlignment="Center"
                      Content="{loc:Tr BulkExport.OpenFolder}"/>
            <CheckBox x:Name="SelectFilesCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14 0 0 0"
                      Content="{loc:Tr BulkExport.SelectFiles}" IsEnabled="{Binding IsChecked, ElementName=OpenFolderCheck}"/>
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{loc:Tr Common.Close}" Width="92" Padding="0 4" Margin="8 0 0 0" Click="OnClose" IsCancel="True"/>
            <Button x:Name="StartButton" DockPanel.Dock="Right" Content="{loc:Tr BulkExport.Export}" Width="92" Padding="0 4" Click="OnStart" IsDefault="True"/>
        </DockPanel>
    </Grid>
</Window>
