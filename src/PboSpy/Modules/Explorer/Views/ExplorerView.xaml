<UserControl x:Class="PboSpy.Modules.Explorer.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:converters="clr-namespace:PboSpy.Modules.Explorer.Converters"
             xmlns:models="clr-namespace:PboSpy.Modules.Explorer.Models"
             xmlns:behaviors="clr-namespace:PboSpy.Modules.Explorer.Behaviors"
             xmlns:loc="clr-namespace:PboSpy.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="320">
    <UserControl.Resources>
        <converters:TreeItemToIconConverter x:Key="IconConverter"/>
        <models:TreeChildrenConverter x:Key="ChildrenConverter"/>
        <converters:TreeItemSelectedConverter x:Key="SelectedConverter"/>
        <converters:TreeItemSelectableConverter x:Key="SelectableConverter"/>
        <converters:TreeItemVisibilityConverter x:Key="VisibilityConverter"/>
        <converters:FileSizeConverter x:Key="SizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="4 2"/>
            <Setter Property="Margin" Value="1 0"/>
        </Style>
    </UserControl.Resources>

    <Grid cal:Message.Attach="[Drop] = [Action OnDrop($eventArgs)];
          [DragOver] = [Action OnDragOver($eventArgs)]"
          AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ToolBar ToolBarTray.IsLocked="True" Loaded="OnToolBarLoaded">
            <Button x:Name="ExtractSelectedPbo" ToolTip="{loc:Tr Explorer.ExtractPboTip}">
                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/ExtractPBO.png" Width="16" Height="16"/>
            </Button>
            <Button Click="OnExportClick" ToolTip="{loc:Tr Explorer.ExportTip}">
                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/ExtractFile.png" Width="16" Height="16"/>
            </Button>
            <Separator/>
            <Button Click="OnExpandAll" ToolTip="{loc:Tr Explorer.ExpandAll}" Content="⊞" FontSize="14" Padding="4 0"/>
            <Button Click="OnCollapseAll" ToolTip="{loc:Tr Explorer.CollapseAll}" Content="⊟" FontSize="14" Padding="4 0"/>
            <Separator/>
            <ToggleButton x:Name="FilterToggle" IsChecked="{Binding IsFilterOpen, Mode=TwoWay}"
                          ToolTip="{loc:Tr Explorer.Filter.Tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Explorer.Filter.Button}"/>
                    <TextBlock Text=" ●" Foreground="OrangeRed"
                               Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text=" ▾"/>
                </StackPanel>
            </ToggleButton>
        </ToolBar>

        <Popup Grid.Row="0" PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom"
               IsOpen="{Binding IsFilterOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource MenuPopupDefaultBackground}"
                    BorderBrush="{DynamicResource MenuPopupDefaultBorder}" BorderThickness="1" Padding="8" MinWidth="240">
                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MenuPopupDefaultText}"/>
                    </Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Foreground" Value="{DynamicResource MenuPopupDefaultText}"/>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <TextBlock Text="{Binding FilterScopeText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    <TextBlock Text="{loc:Tr Explorer.Filter.Hint}" Opacity="0.7" Margin="0 2 0 6" TextWrapping="Wrap" MaxWidth="320"/>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                        <Button Content="{loc:Tr Explorer.Filter.All}" cal:Message.Attach="CheckAllFilters" Padding="8 2"/>
                        <Button Content="{loc:Tr Explorer.Filter.None}" cal:Message.Attach="UncheckAllFilters" Padding="8 2" Margin="4 0"/>
                        <Button Content="{loc:Tr Explorer.Filter.Invert}" cal:Message.Attach="InvertFilters" Padding="8 2"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExtensionFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0 2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" MinWidth="110"/>
                                            <TextBlock Text="{Binding Count}" Opacity="0.6"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Separator Margin="0 6"/>
                    <CheckBox IsChecked="{Binding HideFilteredFiles}" Content="{loc:Tr Explorer.Filter.Hide}"/>
                    <Button Content="{loc:Tr Explorer.Filter.SelectChecked}" cal:Message.Attach="SelectAllOfCheckedTypes"
                            HorizontalAlignment="Left" Padding="8 2" Margin="0 6 0 0"/>
                </StackPanel>
            </Border>
        </Popup>

        <DockPanel Grid.Row="1" Margin="2 2 2 2">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Explorer.Search.Select}" cal:Message.Attach="SelectMatching"
                    Padding="8 1" Margin="2 0 0 0" ToolTip="{loc:Tr Explorer.Search.Tip}"/>
            <Grid>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         cal:Message.Attach="[KeyDown] = [Action OnSearchKey($eventArgs)]"
                         ToolTip="{loc:Tr Explorer.Search.Tip}" VerticalContentAlignment="Center" Padding="2 1"/>
                <TextBlock Text="{loc:Tr Explorer.Search.Placeholder}" IsHitTestVisible="False" Opacity="0.5"
                           Margin="6 0" VerticalAlignment="Center" Foreground="{DynamicResource TreeViewItem.Static.Text}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <TreeView Grid.Row="2" x:Name="Items" PreviewKeyDown="OnTreeKeyDown" TreeViewItem.Expanded="OnItemExpanded"
                  behaviors:TreeMultiSelect.Host="{Binding}"
                  cal:Message.Attach="[SelectedItemChanged] = [Action OnSelectedItemChanged($eventArgs)]">
            <TreeView.Resources>
                <!-- The native highlight only marks the focused item; the multi selection draws its own. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="TreeViewItem.Highlight.Static" Color="Transparent"/>
                <SolidColorBrush x:Key="TreeViewItem.Highlight.Inactive" Color="Transparent"/>
            </TreeView.Resources>

            <TreeView.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem x:Name="MenuOpen" Header="{loc:Tr Explorer.Menu.Open}" Click="OnMenuOpen"/>
                    <MenuItem x:Name="MenuModelPreview" Header="{loc:Tr Explorer.Menu.ModelPreview}" Click="OnMenuOpen" FontWeight="SemiBold"/>
                    <MenuItem x:Name="MenuExport" Header="{loc:Tr Explorer.Menu.Export}" Click="OnExportClick" InputGestureText="Ctrl+Shift+E"/>
                    <MenuItem x:Name="MenuExtractPbo" Header="{loc:Tr Explorer.Menu.ExtractPbo}" Click="OnMenuExtractPbo"/>
                    <MenuItem x:Name="MenuConvert" Header="{loc:Tr Explorer.Menu.ConvertSelected}" Click="OnMenuConvert"/>
                    <MenuItem x:Name="MenuNames" Header="{loc:Tr Explorer.Menu.RecoverNames}" Click="OnMenuNames"/>
                    <MenuItem x:Name="MenuModelsUsing" Header="{loc:Tr Explorer.Menu.ModelsUsing}" Click="OnMenuModelsUsing"/>
                    <Separator/>
                    <MenuItem x:Name="MenuP3d" Header="{loc:Tr Explorer.Menu.P3d}">
                        <MenuItem Header="{loc:Tr P3D.Main.BtnDebin}" Click="OnMenuP3dDebin"/>
                        <MenuItem Header="{loc:Tr P3D.Main.BtnExtractRvmats}" Click="OnMenuP3dRvmats"/>
                        <MenuItem Header="{loc:Tr P3D.Main.BtnExtractCfg}" Click="OnMenuP3dCfg"/>
                        <MenuItem Header="{loc:Tr P3D.Main.BtnChangePaths}" Click="OnMenuP3dPaths"/>
                        <MenuItem Header="{loc:Tr P3D.Main.BtnStrip}" Click="OnMenuP3dStrip"/>
                        <MenuItem Header="{loc:Tr Explorer.Menu.ExportModel}" Click="OnMenuExportModel"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Explorer.Menu.OpenInP3d}" Click="OnMenuP3dOpen"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuPbr" Header="{loc:Tr Explorer.Menu.Pbr}" Click="OnMenuPbr"/>
                    <Separator/>
                    <MenuItem x:Name="MenuSelectFolder" Header="{loc:Tr Explorer.Menu.SelectFolder}" Click="OnMenuSelectFolder"/>
                    <MenuItem x:Name="MenuSelectType" Header="{loc:Tr Explorer.Menu.SelectType}" Click="OnMenuSelectType"/>
                    <MenuItem x:Name="MenuClearSelection" Header="{loc:Tr Explorer.Menu.ClearSelection}" Click="OnMenuClearSelection" InputGestureText="Esc"/>
                    <Separator/>
                    <MenuItem x:Name="MenuRename" Header="{loc:Tr Explorer.Menu.Rename}" Click="OnMenuRename" InputGestureText="F2"/>
                    <MenuItem x:Name="MenuCopyPath" Header="{loc:Tr Explorer.Menu.CopyPath}" Click="OnMenuCopyPath"/>
                    <MenuItem x:Name="MenuCopyPathInPbo" Header="{loc:Tr Explorer.Menu.CopyPathInPbo}" Click="OnMenuCopyPathInPbo"/>
                    <MenuItem x:Name="MenuShowInExplorer" Header="{loc:Tr Explorer.Menu.ShowInExplorer}" Click="OnMenuShowInExplorer"/>
                    <Separator/>
                    <MenuItem x:Name="MenuHide" Header="{loc:Tr Explorer.Menu.Hide}" Click="OnMenuHide"/>
                    <MenuItem x:Name="MenuClose" Header="{loc:Tr Explorer.Menu.Close}" Click="OnMenuClose"/>
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <!-- The inherited theme style opens every folder; start collapsed. -->
                    <Setter Property="IsExpanded" Value="False"/>
                    <Setter Property="cal:Message.Attach"
                            Value="[MouseDoubleClick] = [Action OpenPreview($dataContext)]"/>
                    <Setter Property="IsEnabled">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource SelectableConverter}">
                                <Binding/>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                <Binding Path="DataContext.FilterVersion" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Visibility">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource VisibilityConverter}">
                                <Binding/>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                <Binding Path="DataContext.FilterVersion" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding ., Converter={StaticResource ChildrenConverter}}">
                    <Border x:Name="Row" CornerRadius="2" Padding="2 1" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ., Mode=OneWay, Converter={StaticResource IconConverter}}" Width="16" Height="16" Margin="0 0 4 0"/>
                            <TextBlock x:Name="Label" Text="{Binding Name}"/>
                            <TextBlock Text="{Binding ., Converter={StaticResource SizeConverter}}" Opacity="0.5" Margin="8 0 0 0" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource SelectedConverter}">
                                    <Binding/>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                    <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Explorer.SelectionBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Explorer.SelectionTextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRenamed, FallbackValue=False}" Value="True">
                            <Setter TargetName="Label" Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Explorer.FocusBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.35"/>
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock Grid.Row="3" Text="{Binding SelectionSummary}" Margin="4 2" Opacity="0.8"
                   Foreground="{DynamicResource TreeViewItem.Static.Text}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
