<UserControl x:Class="PboSpy.Modules.Start.StartPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:loc="clr-namespace:PboSpy.Localization"
             Background="{DynamicResource PboSpy.Surface}" Foreground="{DynamicResource PboSpy.Text}"
             FontFamily="Segoe UI" FontSize="12.5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PboSpy.TextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0 3 0 0"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="Image">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0 0 12 0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40 32 40 24" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hero -->
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/PboSpy;component/Resources/Icons/WindowIcon.png"
                       Width="56" Height="56" Margin="0 0 18 0" VerticalAlignment="Top"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PboSpy" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource PboSpy.TextDim}" VerticalAlignment="Bottom" Margin="10 0 0 6"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Start.Subtitle}" Style="{StaticResource PboSpy.Subtitle}" FontSize="14" Margin="0 4 0 0"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0 28 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Actions -->
                <StackPanel>
                    <TextBlock Text="{loc:Tr Start.Open}" Style="{StaticResource PboSpy.Section}"/>
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource PboSpy.Tile}" Margin="0 0 8 8" cal:Message.Attach="OpenFiles">
                            <DockPanel>
                                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/OpenFiles.png" Style="{StaticResource TileIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Start.OpenFiles}" Style="{StaticResource TileTitle}"/>
                                    <TextBlock Text="{loc:Tr Start.OpenFilesText}" Style="{StaticResource TileText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource PboSpy.Tile}" Margin="0 0 0 8" cal:Message.Attach="OpenFolder">
                            <DockPanel>
                                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/OpenFolder.png" Style="{StaticResource TileIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Start.OpenFolder}" Style="{StaticResource TileTitle}"/>
                                    <TextBlock Text="{loc:Tr Start.OpenFolderText}" Style="{StaticResource TileText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="{loc:Tr Start.Tools}" Style="{StaticResource PboSpy.Section}" Margin="0 14 0 6"/>
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource PboSpy.Tile}" Margin="0 0 8 8" cal:Message.Attach="ConvertFiles">
                            <DockPanel>
                                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/ExtractImage.png" Style="{StaticResource TileIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Start.Convert}" Style="{StaticResource TileTitle}"/>
                                    <TextBlock Text="{loc:Tr Start.ConvertText}" Style="{StaticResource TileText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource PboSpy.Tile}" Margin="0 0 0 8" cal:Message.Attach="ConvertFolder">
                            <DockPanel>
                                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/FolderClosed.png" Style="{StaticResource TileIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Start.ConvertFolder}" Style="{StaticResource TileTitle}"/>
                                    <TextBlock Text="{loc:Tr Start.ConvertFolderText}" Style="{StaticResource TileText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource PboSpy.Tile}" Margin="0 0 8 8" cal:Message.Attach="OpenP3dTools">
                            <DockPanel>
                                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/p3d.png" Style="{StaticResource TileIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Command.P3dTools}" Style="{StaticResource TileTitle}"/>
                                    <TextBlock Text="{loc:Tr Start.P3dText}" Style="{StaticResource TileText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource PboSpy.Tile}" Margin="0 0 0 8" cal:Message.Attach="OpenPbrMaker">
                            <DockPanel>
                                <Image Source="pack://application:,,,/PboSpy;component/Resources/Icons/paa.png" Style="{StaticResource TileIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Command.PbrMaker}" Style="{StaticResource TileTitle}"/>
                                    <TextBlock Text="{loc:Tr Start.PbrText}" Style="{StaticResource TileText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Recent -->
                <StackPanel Grid.Column="2">
                    <DockPanel Margin="0 0 0 6">
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Start.ClearRecent}" Style="{StaticResource PboSpy.Link}"
                                cal:Message.Attach="ClearRecent" VerticalAlignment="Center"
                                Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{loc:Tr Start.Recent}" Style="{StaticResource PboSpy.Section}" Margin="0"/>
                    </DockPanel>
                    <Border Style="{StaticResource PboSpy.Card}" Padding="4">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PboSpy.Tile}" BorderThickness="0" Background="Transparent" Margin="0 1"
                                                cal:Message.Attach="OpenRecent($dataContext)" ToolTip="{Binding Path}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource PboSpy.TextDim}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Tr Start.NoRecent}" Margin="12 14" Foreground="{DynamicResource PboSpy.TextDim}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecent}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Tips -->
            <Border Grid.Row="2" Style="{StaticResource PboSpy.Card}" Margin="0 20 0 0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Start.Tips}" Style="{StaticResource PboSpy.Section}"/>
                    <TextBlock Text="{loc:Tr Start.Tip1}" Style="{StaticResource TileText}"/>
                    <TextBlock Text="{loc:Tr Start.Tip2}" Style="{StaticResource TileText}"/>
                    <TextBlock Text="{loc:Tr Start.Tip3}" Style="{StaticResource TileText}"/>
                    <TextBlock Text="{loc:Tr Start.Tip4}" Style="{StaticResource TileText}"/>
                    <TextBlock Text="{loc:Tr Start.Tip5}" Style="{StaticResource TileText}"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="3" Margin="0 16 0 0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Tr Start.Settings}" Style="{StaticResource PboSpy.Link}" cal:Message.Attach="OpenSettings" Margin="0 0 16 0"/>
                    <Button Content="{loc:Tr Cmd.About}" Style="{StaticResource PboSpy.Link}" cal:Message.Attach="OpenAbout"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding ShowOnStartup}" Content="{loc:Tr Start.ShowOnStartup}" Foreground="{DynamicResource PboSpy.Text}"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
