<w:ToolWindow x:Class="PboSpy.Modules.P3dTools.Views.ChangePathsWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:PboSpy.Modules.Windows"
              xmlns:loc="clr-namespace:PboSpy.Localization"
              Title="{loc:Tr P3D.Cp.Title}" Width="900" Height="760" MinWidth="720" MinHeight="560"
              ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="14 10 14 12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Tr P3D.Cp.Info}" Style="{StaticResource PboSpy.Subtitle}"/>
        <TextBlock Grid.Row="1" Text="{loc:Tr P3D.Cp.LblFiles}" Style="{StaticResource PboSpy.Section}" Margin="0 10 0 4"/>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Margin="8 0 0 0" Width="130">
                <Button Content="{loc:Tr P3D.Cp.BtnAll}" Style="{StaticResource PboSpy.Button}" Click="OnCheckAll"/>
                <Button Content="{loc:Tr P3D.Cp.BtnNone}" Style="{StaticResource PboSpy.Button}" Margin="0 6 0 0" Click="OnCheckNone"/>
            </StackPanel>
            <ListBox x:Name="FilesList" Style="{StaticResource PboSpy.ListBox}" FontFamily="Consolas">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" ToolTip="{Binding FullPath}"
                                  Foreground="{DynamicResource PboSpy.Text}" Checked="OnFileToggled" Unchecked="OnFileToggled"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <TextBlock Grid.Row="3" Text="{loc:Tr P3D.Cp.LblFilesHint}" Foreground="{DynamicResource PboSpy.TextDim}" FontSize="11" Margin="0 3 0 0"/>

        <TextBlock Grid.Row="4" x:Name="PathsHeader" Style="{StaticResource PboSpy.Section}" Margin="0 10 0 4"/>
        <DataGrid Grid.Row="5" x:Name="PathsGrid" Style="{StaticResource PboSpy.DataGrid}"
                  CellEditEnding="OnCellEditEnding" MouseDoubleClick="OnGridDoubleClick"
                  ClipboardCopyMode="ExcludeHeader">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr P3D.Cp.ColCurrent}" Binding="{Binding Current}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="{loc:Tr P3D.Cp.ColNew}" Binding="{Binding New, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0 10 0 0">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Tr P3D.Cp.LblFrom}" Style="{StaticResource PboSpy.Label}"/>
            <Button DockPanel.Dock="Right" Content="{loc:Tr P3D.Cp.BtnApplyPart}" Style="{StaticResource PboSpy.Button}" Margin="8 0 0 0" Click="OnApplySegment"/>
            <CheckBox DockPanel.Dock="Right" x:Name="RegexCheck" Content="regex" Margin="8 0 0 0" VerticalAlignment="Center"
                      Foreground="{DynamicResource PboSpy.Text}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FromBox" Style="{StaticResource PboSpy.TextBox}" FontFamily="Consolas"/>
                <TextBlock Grid.Column="1" Text="→" Margin="8 0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ToBox" Style="{StaticResource PboSpy.TextBox}" FontFamily="Consolas"/>
            </Grid>
        </DockPanel>
        <TextBlock Grid.Row="7" Text="{loc:Tr P3D.Cp.Hint}" Foreground="{DynamicResource PboSpy.TextDim}" FontSize="11" Margin="0 4 0 0" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="8" x:Name="StatusText" Foreground="{DynamicResource PboSpy.Success}" Margin="0 6 0 0" TextTrimming="CharacterEllipsis"/>

        <DockPanel Grid.Row="9" Margin="0 10 0 0">
            <Button Content="{loc:Tr P3D.Cp.BtnImport}" Style="{StaticResource PboSpy.Button}" Click="OnImport"/>
            <Button Content="{loc:Tr P3D.Cp.BtnExport}" Style="{StaticResource PboSpy.Button}" Margin="6 0 0 0" Click="OnExport"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr P3D.Cp.BtnCancel}" Style="{StaticResource PboSpy.Button}" Margin="0 0 6 0" IsCancel="True" Click="OnCancel"/>
                <Button Content="{loc:Tr P3D.Cp.BtnOk}" Style="{StaticResource PboSpy.AccentButton}" Click="OnOk"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</w:ToolWindow>
