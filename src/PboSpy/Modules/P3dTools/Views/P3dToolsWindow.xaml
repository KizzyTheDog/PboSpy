<w:ToolWindow x:Class="PboSpy.Modules.P3dTools.Views.P3dToolsWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:PboSpy.Modules.Windows"
              xmlns:loc="clr-namespace:PboSpy.Localization"
              Title="{loc:Tr P3D.Main.Title}" Width="760" Height="640" MinWidth="640" MinHeight="520"
              AllowDrop="True">
    <Grid Margin="18 14 18 12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{loc:Tr P3D.Main.LblLanguage}" Style="{StaticResource PboSpy.Label}"/>
                <ComboBox x:Name="LanguageBox" Width="150" DisplayMemberPath="NativeName" SelectionChanged="OnLanguageChanged"/>
                <ToggleButton x:Name="TopmostToggle" Style="{StaticResource PboSpy.Button}" Margin="8 0 0 0" Padding="8 3"
                              ToolTip="{loc:Tr Window.KeepOnTop}" Content="📌"
                              IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="P3D Debinarizer" Style="{StaticResource PboSpy.Title}" Foreground="{DynamicResource PboSpy.Accent}"/>
                <TextBlock Text="{loc:Tr P3D.Main.Subtitle}" Style="{StaticResource PboSpy.Subtitle}" Margin="0 2 0 0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" x:Name="BisDllBanner" Visibility="Collapsed" Margin="0 12 0 0" Padding="10 8" CornerRadius="4"
                Background="{DynamicResource PboSpy.SurfaceAlt}" BorderBrush="{DynamicResource PboSpy.Warning}" BorderThickness="1">
            <TextBlock Text="{loc:Tr P3D.Main.BisDllMissing}" TextWrapping="Wrap" Foreground="{DynamicResource PboSpy.Warning}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PboSpy.Separator}"/>

        <!-- Input / output -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="{loc:Tr P3D.Main.LblInput}" Margin="0 0 0 4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="FolderButton" Content="{loc:Tr P3D.Main.BtnFolder}" Style="{StaticResource PboSpy.Button}"
                        Margin="6 0 0 0" MinWidth="92" Click="OnPickFolder"/>
                <Button DockPanel.Dock="Right" x:Name="FileButton" Content="{loc:Tr P3D.Main.BtnFile}" Style="{StaticResource PboSpy.Button}"
                        Margin="6 0 0 0" MinWidth="92" Click="OnPickFile"/>
                <TextBox x:Name="InputBox" Style="{StaticResource PboSpy.TextBox}" TextChanged="OnInputChanged"/>
            </DockPanel>
            <TextBlock Text="{loc:Tr P3D.Main.LblOutput}" Margin="0 12 0 4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="OpenInAppButton" Content="{loc:Tr P3D.Main.BtnOpenInApp}" Style="{StaticResource PboSpy.Button}"
                        Margin="6 0 0 0" Click="OnOpenInApp" IsEnabled="False" ToolTip="{loc:Tr P3D.Main.BtnOpenInAppTip}"/>
                <Button DockPanel.Dock="Right" Content="{loc:Tr P3D.Main.BtnOpen}" Style="{StaticResource PboSpy.Button}"
                        Margin="6 0 0 0" MinWidth="92" Click="OnOpenOutput"/>
                <Button DockPanel.Dock="Right" x:Name="OutputButton" Content="{loc:Tr P3D.Main.BtnSelect}" Style="{StaticResource PboSpy.Button}"
                        Margin="6 0 0 0" MinWidth="92" Click="OnPickOutput"/>
                <TextBox x:Name="OutputBox" Style="{StaticResource PboSpy.TextBox}"/>
            </DockPanel>
            <DockPanel Margin="0 8 0 0">
                <CheckBox DockPanel.Dock="Right" x:Name="MirrorCheck" Content="{loc:Tr P3D.Main.Mirror}"
                          Foreground="{DynamicResource PboSpy.Text}" VerticalAlignment="Center"/>
                <CheckBox DockPanel.Dock="Right" x:Name="CompactCheck" Content="{loc:Tr P3D.Main.Compact}" ToolTip="{loc:Tr P3D.Main.CompactTip}"
                          Foreground="{DynamicResource PboSpy.Text}" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <CheckBox DockPanel.Dock="Right" x:Name="StripCheck" Content="{loc:Tr P3D.Main.StripProxies}" ToolTip="{loc:Tr P3D.Main.StripProxiesTip}"
                          Foreground="{DynamicResource PboSpy.Text}" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <TextBlock x:Name="FormatText" Foreground="{DynamicResource PboSpy.TextDim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource PboSpy.Separator}"/>

        <!-- Actions -->
        <UniformGrid Grid.Row="5" Rows="1" Columns="5">
            <Button x:Name="ChangePathsButton" Content="{loc:Tr P3D.Main.BtnChangePaths}" Style="{StaticResource PboSpy.AccentButton}"
                    Margin="0 0 6 0" Padding="8 10" Click="OnChangePaths"/>
            <Button x:Name="DebinButton" Content="{loc:Tr P3D.Main.BtnDebin}" Style="{StaticResource PboSpy.AccentButton}"
                    Margin="3 0" Padding="8 10" Click="OnDebinarize"/>
            <Button x:Name="RvmatButton" Content="{loc:Tr P3D.Main.BtnExtractRvmats}" Style="{StaticResource PboSpy.AccentButton}"
                    Margin="3 0" Padding="8 10" Click="OnRvmats"/>
            <Button x:Name="CfgButton" Content="{loc:Tr P3D.Main.BtnExtractCfg}" Style="{StaticResource PboSpy.AccentButton}"
                    Margin="3 0" Padding="8 10" Click="OnModelCfg"/>
            <Button x:Name="StripButton" Content="{loc:Tr P3D.Main.BtnStrip}" Style="{StaticResource PboSpy.AccentButton}"
                    Margin="6 0 0 0" Padding="8 10" Click="OnStrip" ToolTip="{loc:Tr P3D.Main.StripProxiesTip}"/>
        </UniformGrid>

        <ProgressBar Grid.Row="6" x:Name="Progress" Margin="0 10 0 0" Visibility="Hidden"/>

        <DockPanel Grid.Row="7" Margin="0 8 0 4">
            <Button DockPanel.Dock="Right" Content="{loc:Tr P3D.Main.BtnClearLog}" Style="{StaticResource PboSpy.Button}"
                    Padding="8 2" Click="OnClearLog"/>
            <Button DockPanel.Dock="Right" Content="{loc:Tr P3D.Main.BtnCopyLog}" Style="{StaticResource PboSpy.Button}"
                    Padding="8 2" Margin="0 0 6 0" Click="OnCopyLog"/>
            <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="{loc:Tr P3D.Main.BtnCancel}" Style="{StaticResource PboSpy.Button}"
                    Padding="8 2" Margin="0 0 6 0" Click="OnCancel" Visibility="Collapsed"/>
            <TextBlock Text="{loc:Tr P3D.Main.LblLog}" VerticalAlignment="Center"/>
        </DockPanel>

        <RichTextBox Grid.Row="8" x:Name="LogBox" Style="{StaticResource PboSpy.Log}">
            <FlowDocument PagePadding="2"/>
        </RichTextBox>

        <TextBlock Grid.Row="9" x:Name="StatusText" Margin="0 8 0 0" Foreground="{DynamicResource PboSpy.TextDim}"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</w:ToolWindow>
