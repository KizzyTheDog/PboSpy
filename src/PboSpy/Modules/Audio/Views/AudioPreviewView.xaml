<UserControl x:Class="PboSpy.Modules.Audio.Views.AudioPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:loc="clr-namespace:PboSpy.Localization"
             Background="{DynamicResource EnvironmentWindowBackground}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TreeViewItem.Static.Text}"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Info}" Margin="0 0 0 8" Opacity="0.85"/>

        <Border Grid.Row="1" Background="#FF15181C" CornerRadius="4" MinHeight="120" ClipToBounds="True"
                MouseLeftButtonDown="OnWaveformClick" Cursor="Hand">
            <Grid x:Name="WaveHost">
                <Image Source="{Binding Waveform}" Stretch="Fill"/>
                <Canvas>
                    <Rectangle x:Name="PlayHead" Width="2" Fill="#FFFFB020"
                               Height="{Binding ActualHeight, ElementName=WaveHost}"/>
                </Canvas>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0 8 0 0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="8 0 0 0" MinWidth="110"/>
            <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" VerticalAlignment="Center"
                    PreviewMouseDown="OnSliderDown" PreviewMouseUp="OnSliderUp"/>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 8 0 0">
            <Button cal:Message.Attach="PlayPause" Padding="14 4" MinWidth="90">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:Tr Audio.Play}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Text" Value="{loc:Tr Audio.Pause}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button cal:Message.Attach="Stop" Content="{loc:Tr Audio.Stop}" Padding="14 4" Margin="6 0"/>
            <CheckBox IsChecked="{Binding Loop}" Content="{loc:Tr Audio.Loop}" VerticalAlignment="Center" Margin="6 0"
                      Foreground="{DynamicResource TreeViewItem.Static.Text}"/>
            <TextBlock Text="{loc:Tr Audio.Volume}" VerticalAlignment="Center" Margin="12 0 6 0"/>
            <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"/>
            <Button cal:Message.Attach="SaveAs" Content="{loc:Tr Audio.SaveAs}" Padding="14 4" Margin="16 0 0 0"/>
        </StackPanel>
    </Grid>
</UserControl>
