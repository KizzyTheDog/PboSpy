<Application x:Class="PboSpy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PboSpy">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PboSpy;component/Resources/Styles.xaml"/>
                <ResourceDictionary>
                    <local:SingleFileBootstrapper x:Key="bootstrapper" />
                    <SolidColorBrush x:Key="Explorer.SelectionBrush" Color="#FF3399FF"/>
                    <SolidColorBrush x:Key="Explorer.SelectionTextBrush" Color="White"/>
                    <SolidColorBrush x:Key="Explorer.FocusBrush" Color="#FF007ACC"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
